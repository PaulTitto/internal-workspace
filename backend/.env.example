# Konfigurasi Environment Backend Python Flask
FLASK_ENV=development
FLASK_PORT=5000
DATABASE_URL="sqlite:///jiravue.db"

# Konfigurasi Microsoft Entra ID (Azure AD) SSO
AZURE_TENANT_ID="72f988bf-86f1-41af-91ab-2d7cd011db47"
AZURE_CLIENT_ID="a8f412c0-3b91-4e7a-9c1d-55f802e19a11"

# OAuth 2.0 multi-provider (opsional):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FRONTEND_URL="http://localhost:5173"

# ---- SMTP Email Settings untuk Notifikasi Mention (@mention) ----
# Contoh konfigurasi menggunakan Gmail:
# 1. Buka Akun Google > Keamanan > Verifikasi 2 Langkah > Sandi Aplikasi (App passwords)
# 2. Masukkan alamat Gmail Anda di SMTP_USER dan 16 karakter app password di SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_USE_TLS=true
